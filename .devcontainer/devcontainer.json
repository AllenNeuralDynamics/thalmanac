{
	"name": "THALMANAC App",
    "dockerComposeFile": "../environment/docker-compose.yml",
    "service": "streamlit",
    "workspaceFolder": "/root/capsule",
    "overrideCommand": true,
	"remoteEnv": {
		"PATH": "${containerEnv:PATH}:/root/.local/bin:/root/capsule/code"
	},
    "postAttachCommand": "streamlit run /root/capsule/code/streamlit_app.py"
}